#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# AMC - AI Mobile Center CLI Service Manager for Termux
# Usage: amc [start|stop|restart|status|logs|autostart|boost]
# ==============================================================================

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PREFIX
export PATH="$PREFIX/bin:$PREFIX/bin/applets:$PATH"

DIR="$HOME/.termux_agent"
PID_FILE="$DIR/daemon.pid"
LOG_FILE="$DIR/daemon.log"
TOKEN_FILE="$HOME/.termux_agent_token"
DAEMON_SCRIPT="$DIR/bridge_daemon.py"

mkdir -p "$DIR" 2>/dev/null || true

PYTHON_BIN=""
if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
elif [ -x "$PREFIX/bin/python3" ]; then
    PYTHON_BIN="$PREFIX/bin/python3"
elif [ -x "$PREFIX/bin/python" ]; then
    PYTHON_BIN="$PREFIX/bin/python"
else
    PYTHON_BIN="python"
fi

is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    if "$PYTHON_BIN" -c "import socket; s = socket.socket(); s.settimeout(0.5); s.connect(('127.0.0.1', 8765)); s.close()" 2>/dev/null; then
        return 0
    fi
    return 1
}

get_token() {
    if [ -f "$TOKEN_FILE" ]; then
        cat "$TOKEN_FILE" 2>/dev/null | tr -d '\r\n'
    else
        echo ""
    fi
}

cmd_start() {
    if is_running; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || echo "aktiv")
        echo "🟢 AMC Bridge läuft bereits im Hintergrund (PID: $pid)."
        return 0
    fi

    echo "🚀 Starte AMC Termux Bridge im Hintergrund..."

    # 1. CPU-Wake-Lock aktivieren (hält Termux als Foreground-Service aktiv)
    if command -v termux-wake-lock >/dev/null 2>&1; then
        termux-wake-lock >/dev/null 2>&1 || true
        echo "🔋 Wake-Lock aktiviert (Hintergrundausführung gesichert)."
    fi

    # 2. Daemon entkoppelt im Hintergrund starten (nohup + disown)
    cd "$DIR" 2>/dev/null || true
    nohup "$PYTHON_BIN" -u "$DAEMON_SCRIPT" < /dev/null >> "$LOG_FILE" 2>&1 &
    local new_pid=$!
    disown "$new_pid" 2>/dev/null || true

    # 3. Warten bis der Socket auf Port 8765 lauscht (bis zu 6 Sekunden)
    local started=0
    for i in {1..12}; do
        if "$PYTHON_BIN" -c "import socket; s = socket.socket(); s.settimeout(0.5); s.connect(('127.0.0.1', 8765)); s.close()" 2>/dev/null; then
            started=1
            break
        fi
        sleep 0.5
    done

    # Verwende tatsächliche PID aus PID_FILE falls vom Daemon geschrieben
    local actual_pid
    actual_pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    if [ -z "$actual_pid" ] || ! kill -0 "$actual_pid" 2>/dev/null; then
        actual_pid="$new_pid"
        echo "$actual_pid" > "$PID_FILE"
    fi

    if [ "$started" -eq 1 ]; then
        echo "✅ AMC Bridge erfolgreich im Hintergrund gestartet (PID: $actual_pid)!"
        echo "📡 WebSocket: ws://127.0.0.1:8765"
        echo "📄 Logs: amc logs"
        local tok
        tok=$(get_token)
        if [ -n "$tok" ]; then
            echo "🔑 Token: $tok"
        fi
        echo "💡 Termux jetzt einfach geöffnet lassen (Home-Taste drücken) – NICHT mit 'exit' beenden!"
    else
        echo "❌ Fehler beim Starten des Bridge-Daemons. Letzte Zeilen des Logs:"
        tail -n 20 "$LOG_FILE" 2>/dev/null || true
        return 1
    fi
}

cmd_start_silent() {
    if ! is_running; then
        cmd_start > /dev/null 2>&1 || true
    fi
}

cmd_stop() {
    if ! is_running; then
        echo "⚪ AMC Bridge ist nicht aktiv."
        rm -f "$PID_FILE"
        pkill -f "bridge_daemon.py" 2>/dev/null || true
        return 0
    fi

    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || echo "")
    echo "🛑 Stoppe AMC Bridge (PID: $pid)..."

    if [ -n "$pid" ]; then
        kill -TERM "$pid" 2>/dev/null || true

        # Warte bis zu 3 Sekunden auf Beendigung
        for i in {1..6}; do
            if ! kill -0 "$pid" 2>/dev/null; then
                break
            fi
            sleep 0.5
        done

        # Notfalls hart beenden
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    # Sicherstellen, dass kein verwaister Daemon-Prozess lauscht
    pkill -f "bridge_daemon.py" 2>/dev/null || true
    rm -f "$PID_FILE"

    # Benachrichtigung entfernen
    if command -v termux-notification-remove >/dev/null 2>&1; then
        termux-notification-remove amc_bridge 2>/dev/null || true
    fi

    # Wake-Lock freigeben
    if command -v termux-wake-unlock >/dev/null 2>&1; then
        termux-wake-unlock 2>/dev/null || true
    fi

    echo "✅ AMC Bridge gestoppt."
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_run() {
    echo "🚀 Starte AMC Termux Bridge im Vordergrund (Strg+C zum Beenden)..."
    if command -v termux-wake-lock >/dev/null 2>&1; then
        termux-wake-lock >/dev/null 2>&1 || true
        echo "🔋 Wake-Lock aktiviert."
    fi
    cd "$DIR" 2>/dev/null || true
    "$PYTHON_BIN" -u "$DAEMON_SCRIPT"
}

cmd_status() {
    echo "=================================================="
    echo " AMC - AI Mobile Center Service Status"
    echo "=================================================="
    local port_ok=0
    if "$PYTHON_BIN" -c "import socket; s = socket.socket(); s.settimeout(0.5); s.connect(('127.0.0.1', 8765)); s.close()" 2>/dev/null; then
        port_ok=1
    fi

    if is_running || [ "$port_ok" -eq 1 ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || echo "aktiv")
        echo "Status:       🟢 AKTIV (Hintergrund)"
        echo "PID:          $pid"
        echo "Port:         8765"
        echo "Port-Status:  ✅ 127.0.0.1:8765 erreichbar & lauscht"

        local tok
        tok=$(get_token)
        if [ -n "$tok" ]; then
            echo "Auth-Token:   $tok"
        else
            echo "Auth-Token:   Offener lokaler Modus (kein Token nötig)"
        fi

        # Akku-Info falls termux-api vorhanden
        if command -v termux-battery-status >/dev/null 2>&1; then
            local batt
            batt=$(termux-battery-status 2>/dev/null || echo "")
            if [ -n "$batt" ]; then
                local pct
                pct=$(echo "$batt" | grep -o '"percentage": [0-9]*' | awk '{print $2}' || echo "")
                [ -n "$pct" ] && echo "Akku:         ${pct}%"
            fi
        fi
        echo "Hintergrund:  💡 Termux muss im Hintergrund bleiben (nicht 'exit' tippen!)"
    else
        echo "Status:       ⚪ INAKTIV"
        echo "Tipp:         'amc start' zum Starten im Hintergrund eingeben"
        echo "              'amc boost' zur automatischen Hintergrundoptimierung"
    fi
    echo "=================================================="
}

cmd_boost() {
    echo "=================================================="
    echo " 🚀 AMC Hintergrund-Optimierung & Wake-Lock Boost"
    echo "=================================================="

    # 1. CPU-Wake-Lock aktivieren
    if command -v termux-wake-lock >/dev/null 2>&1; then
        termux-wake-lock >/dev/null 2>&1 || true
        echo "✅ CPU-Wake-Lock aktiviert (Termux Foreground-Service)."
    else
        echo "⚠️ termux-wake-lock nicht verfügbar."
    fi

    # 2. Android Akku-Optimierung anfordern
    echo "🔋 Fordere Android Akku-Ausnahme für Termux an..."
    if command -v am >/dev/null 2>&1; then
        am start -a android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS -d package:com.termux >/dev/null 2>&1 || \
        am start -a android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS >/dev/null 2>&1 || \
        am start -a android.settings.APPLICATION_DETAILS_SETTINGS -d package:com.termux >/dev/null 2>&1 || true
        echo "   👉 Bitte im Android-Dialog 'Zulassen' bzw. 'Nicht optimiert' wählen!"
    fi

    # 3. Benachrichtigungen für Foreground-Service anfordern (Android 13+)
    if command -v am >/dev/null 2>&1; then
        am start -a android.settings.APP_NOTIFICATION_SETTINGS --es android.provider.extra.APP_PACKAGE com.termux >/dev/null 2>&1 || true
    fi

    # 4. Autostart sicherstellen
    cmd_autostart >/dev/null 2>&1 || true

    # 5. Service neu starten
    echo "🔄 Starte AMC Bridge Dienst neu..."
    cmd_restart

    echo ""
    echo "=================================================="
    echo "✅ Boost abgeschlossen!"
    echo "🛑 WICHTIG: Termux geöffnet lassen (Home-Taste)."
    echo "   NICHT mit 'exit' beenden und NICHT wegwischen!"
    echo "=================================================="
}

cmd_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        echo "Noch keine Log-Datei vorhanden ($LOG_FILE)."
        exit 0
    fi
    echo "📄 Zeige AMC Bridge Logs (Strg+C zum Beenden)..."
    tail -n 30 -f "$LOG_FILE"
}

cmd_autostart() {
    # 1. Termux:Boot Verzeichnis
    BOOT_DIR="$HOME/.termux/boot"
    mkdir -p "$BOOT_DIR"
    cat << 'BOOT_EOF' > "$BOOT_DIR/amc_autostart.sh"
#!/data/data/com.termux/files/usr/bin/bash
amc start-silent
BOOT_EOF
    chmod +x "$BOOT_DIR/amc_autostart.sh"

    # 2. .bashrc Autostart
    BASHRC="$HOME/.bashrc"
    if ! grep -q "amc start-silent" "$BASHRC" 2>/dev/null; then
        echo "" >> "$BASHRC"
        echo "# AMC Bridge Auto-Start" >> "$BASHRC"
        echo "command -v amc >/dev/null && amc start-silent" >> "$BASHRC"
    fi

    echo "✅ Autostart eingerichtet:"
    echo "   1. Bei Gerätestart (Termux:Boot): ~/.termux/boot/amc_autostart.sh"
    echo "   2. Beim Öffnen von Termux:        ~/.bashrc"
}

case "$1" in
    start)
        cmd_start
        ;;
    run|foreground)
        cmd_run
        ;;
    start-silent)
        cmd_start_silent
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    boost|fix|fix-background)
        cmd_boost
        ;;
    logs)
        cmd_logs
        ;;
    autostart)
        cmd_autostart
        ;;
    *)
        echo "Verwendung: amc {start|run|stop|restart|status|boost|logs|autostart}"
        echo ""
        echo "Befehle:"
        echo "  amc boost       Reaktiviert Wake-Lock, fordert Akku-Ausnahme an & startet Bridge"
        echo "  amc start       Startet die Bridge im Hintergrund (Wake-Lock + setsid)"
        echo "  amc run         Startet die Bridge im Vordergrund (mit Live-Ausgabe)"
        echo "  amc stop        Beendet die Bridge"
        echo "  amc restart     Startet die Bridge neu"
        echo "  amc status      Zeigt PID, Port, Token und Erreichbarkeit an"
        echo "  amc logs        Zeigt Live-Logs der Bridge an"
        echo "  amc autostart   Richtet automatischen Start bei Boot & Shell-Start ein"
        exit 1
        ;;
esac
