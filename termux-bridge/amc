#!/data/data/com.termux/files/usr/bin/bash
# AMC bridge service manager. Tokens are only displayed by an explicit 'amc token'.
umask 077
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export PREFIX
export PATH="$PREFIX/bin:$PREFIX/bin/applets:$PATH"
DIR="$HOME/.termux_agent"
PID_FILE="$DIR/daemon.pid"
LOG_FILE="$DIR/daemon.log"
TOKEN_FILE="$HOME/.termux_agent_token"
DAEMON_SCRIPT="$DIR/bridge_daemon.py"
mkdir -p "$DIR"
chmod 700 "$DIR"
PYTHON_BIN="$(command -v python3 || command -v python || true)"
if [ -z "$PYTHON_BIN" ]; then
    echo "Python is missing. Run setup.sh first." >&2
    exit 1
fi

process_is_alive() {
    local pid="$1" stat state
    kill -0 "$pid" 2>/dev/null || return 1
    # An exited child can remain visible until its parent reaps it.
    if [ -r "/proc/$pid/stat" ]; then
        stat="$(cat "/proc/$pid/stat" 2>/dev/null)"
        state="${stat##*) }"
        case "$state" in Z\ *|X\ *) return 1 ;; esac
    fi
    return 0
}

is_running() {
    [ -s "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE")"
    case "$pid" in ""|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] || return 1
    process_is_alive "$pid"
}

cmd_start() {
    if is_running; then
        echo "AMC bridge is already running (PID: $(cat "$PID_FILE"))."
        return
    fi
    [ -f "$DAEMON_SCRIPT" ] || { echo "Bridge is missing. Run setup.sh first."; return 1; }
    command -v termux-wake-lock >/dev/null && termux-wake-lock >/dev/null 2>&1 || true
    touch "$LOG_FILE"
    chmod 600 "$LOG_FILE"
    nohup "$PYTHON_BIN" -u "$DAEMON_SCRIPT" < /dev/null >> "$LOG_FILE" 2>&1 &
    local pid=$!
    disown "$pid" 2>/dev/null || true
    for attempt in {1..12}; do
        if is_running && "$PYTHON_BIN" -c "import socket; s=socket.create_connection(('127.0.0.1',8765),0.5); s.close()" 2>/dev/null; then
            echo "AMC bridge started at ws://127.0.0.1:8765."
            echo "Run 'amc token' to pair the app. Leave Termux running in the background."
            return
        fi
        sleep 0.5
    done
    echo "Bridge startup failed. Inspect 'amc logs'." >&2
    return 1
}

cmd_stop() {
    if is_running; then
        local pid
        pid="$(cat "$PID_FILE")"
        if [ -r "/proc/$pid/cmdline" ] && ! grep -qa "bridge_daemon" "/proc/$pid/cmdline" 2>/dev/null; then
            echo "Warning: PID $pid does not appear to be the bridge daemon (PID reused). Cleaning up stale PID file." >&2
            rm -f "$PID_FILE"
            return 0
        fi
        kill -TERM "$pid" 2>/dev/null || true
        # WebSocket close handshake, command cancellation, and Termux:API
        # cleanup can exceed five seconds. Allow graceful shutdown to finish.
        for attempt in {1..60}; do
            process_is_alive "$pid" || break
            sleep 0.5
        done
        if process_is_alive "$pid"; then
            echo "Bridge did not stop. Inspect the process before restarting." >&2
            return 1
        fi
    fi
    rm -f "$PID_FILE"
    command -v termux-notification-remove >/dev/null && termux-notification-remove amc_bridge >/dev/null 2>&1 || true
    command -v termux-wake-unlock >/dev/null && termux-wake-unlock >/dev/null 2>&1 || true
    echo "AMC bridge stopped."
}

cmd_autostart() {
    mkdir -p "$HOME/.termux/boot"
    printf '%s\n' '#!/data/data/com.termux/files/usr/bin/bash' 'amc start-silent' > "$HOME/.termux/boot/amc_autostart.sh"
    chmod +x "$HOME/.termux/boot/amc_autostart.sh"
    if ! grep -q "amc start-silent" "$HOME/.bashrc" 2>/dev/null; then
        printf '\n%s\n' '# AMC bridge autostart' 'command -v amc >/dev/null && amc start-silent' >> "$HOME/.bashrc"
    fi
    echo "Autostart configured for Termux shells and Termux:Boot (install separately)."
}

case "${1:-}" in
    start) cmd_start ;;
    start-silent) is_running || cmd_start >/dev/null 2>&1 ;;
    stop) cmd_stop ;;
    restart) cmd_stop && cmd_start ;;
    run|foreground) exec "$PYTHON_BIN" -u "$DAEMON_SCRIPT" ;;
    token)
        [ -s "$TOKEN_FILE" ] || { echo "No token found. Start the bridge first."; exit 1; }
        cat "$TOKEN_FILE"
        printf '\n'
        ;;
    status)
        if is_running; then
            echo "AMC bridge running (PID: $(cat "$PID_FILE"))."
            echo "Endpoint: ws://127.0.0.1:8765; authentication required."
        else
            echo "AMC bridge stopped. Run 'amc start'."
        fi
        ;;
    logs)
        [ -f "$LOG_FILE" ] || { echo "No log file yet."; exit 0; }
        tail -n 30 -f "$LOG_FILE"
        ;;
    autostart) cmd_autostart ;;
    boost|fix|fix-background)
        command -v termux-wake-lock >/dev/null && termux-wake-lock >/dev/null 2>&1 || true
        if command -v am >/dev/null; then
            am start -a android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS >/dev/null 2>&1 || true
            am start -a android.settings.APP_NOTIFICATION_SETTINGS --es android.provider.extra.APP_PACKAGE com.termux >/dev/null 2>&1 || true
        fi
        cmd_autostart
        nohup bash -c 'amc restart' >/dev/null 2>&1 &
        disown 2>/dev/null || true
        echo "AMC bridge boosted and restarting in background."
        ;;
    *)
        echo "Usage: amc {start|run|stop|restart|status|token|logs|autostart|boost}"
        echo "Use 'token' only when pairing. Do not share tokens or include them in logs."
        exit 1
        ;;
esac
